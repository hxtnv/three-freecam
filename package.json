{
  "name": "three-freecam",
  "version": "0.2.0",
  "description": "Debug camera and editor-style scene-view controls for three.js. Right-drag to look, WASD to fly, middle-drag to pan, alt-drag to orbit. Unity-style free camera in 1.8 kB, no dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "size": "node scripts/size.mjs",
    "check": "npm run typecheck && npm run test && npm run size",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "three",
    "threejs",
    "three.js",
    "camera",
    "controls",
    "camera-controls",
    "debug-camera",
    "debug",
    "freecam",
    "free-camera",
    "noclip",
    "spectator",
    "fly-controls",
    "flycam",
    "orbit-controls",
    "pointer-lock-controls",
    "first-person",
    "unity",
    "editor",
    "editor-camera",
    "scene-view",
    "viewport",
    "flythrough",
    "wasd",
    "level-editor",
    "r3f",
    "react-three-fiber",
    "webgl",
    "webgpu",
    "typescript"
  ],
  "author": {
    "name": "hxtnv",
    "url": "https://github.com/hxtnv"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxtnv/three-freecam.git"
  },
  "bugs": {
    "url": "https://github.com/hxtnv/three-freecam/issues"
  },
  "homepage": "https://hxtnv.github.io/three-freecam/",
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "esbuild": "^0.25.12",
    "three": "^0.186.0",
    "typescript": "^5.6.0"
  },
  "funding": "https://github.com/sponsors/hxtnv"
}
